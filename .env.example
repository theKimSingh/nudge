EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Used by backend/server.js for STT + the live voice agent.
GEMINI_API_KEY=

# Optional. Leave unset — the app auto-detects your Mac's LAN IP from the Metro
# bundle URL each launch (works on simulator and physical device). Only set this
# to override when the backend runs on a different host than Metro.
# EXPO_PUBLIC_BACKEND_URL=http://<mac-lan-ip>:8000
